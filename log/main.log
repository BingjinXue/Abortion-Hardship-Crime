. *********************
. **# Poisson Event Study
. *********************
. global plot_opts omit keep(e*) vert mc(gs0)  xline(5, lp(dash)) yline(0, lc(g
> s5) ) xtitle("Years to Treatment") ytitle("ATT") coeflabels(em5="<=-5" em4="-
> 4" em3 = "-3" em2 = "-2" em1 = "-1" e0 ="0" e1 = "1" e2 = "2" e3 = "3" e4 = "
> 4" e5 = ">=5" ) levels(95) graphregion(color(white))

. 
. estimates clear

. eststo clear

. foreach T in up25 up50 up100 {
  2.         capture drop rel_`T' g_`T'
  3.         capture drop em5 em4 em3 em2 em1 e0 e1 e2 e3 e4 e5
  4. 
.     * First treatment year
.     bysort orin (year): egen g_`T' = min(cond(`T'==1, year, .))
  5. 
.         * relative/event time
.         gen rel_`T' = year - g_`T'
  6. 
.     * Leads
.     gen em5 = rel_`T' <= -5
  7.     gen em4 = rel_`T' == -4
  8.     gen em3 = rel_`T' == -3
  9.     gen em2 = rel_`T' == -2
 10. 
.     * -1 omitted
.         gen em1=0
 11. 
.     * Treatment/post
.     gen e0 = rel_`T' == 0
 12.     gen e1 = rel_`T' == 1
 13.     gen e2 = rel_`T' == 2
 14.     gen e3 = rel_`T' == 3
 15.     gen e4 = rel_`T' == 4
 16.     gen e5 = rel_`T' >= 5
 17. 
.         foreach v in index_property {
 18.                 ppmlhdfe `v' em5 em4 em3 em2 em1 e0 e1 e2 e3 e4 e5 $x if s
> ample_`T'_`v'==1, absorb(orin  year) vce(cluster countyfips) d exp(agency_pop
> ulation)
 19.                 estimates store `v'_`T'
 20.         }
 21. }
