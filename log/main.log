. /*
> Figure 3. Impact of Abortion Provider Distance on Crime by Type and Offender 
> Characteristics
> Poisson DiD with county demographics (as Table 1, columns 2, 4, 6) for
>  Panel A: offenses by crime type
>  Panel B: property crime arrests by sex and age of the arrestee
> Output: ./result/figure/figure3_panelA_type.png
>         ./result/figure/figure3_panelB_age_sex.png
>         ./result/table/figure3_estimates_up25.csv, _up50.csv, _up100.csv (the
>  plotted estimates)
> */
. 
. use "./data_clean/sample_agency.dta", clear

. xtset orin year

Panel variable: orin (strongly balanced)
 Time variable: year, 2009 to 2019
         Delta: 1 unit

. 
. * covariates
. global x white_shr black_shr nonhispan_shr age_15_44_f_shr age_le9_shr age_10
> _19_shr age_20_29_shr age_30_39_shr age_40_49_shr age_50_59_shr

. 
. global tab_opt  "stats(pct ame ame_se N y_mean countyDemo agencyFE yearFE , f
> mt(1 3 3 0 3) labels(`"% effect"' `"AME"' `"AME S.E."' `"N"' `"E[Y|Pre, Treat
> ]"' `"County Demographics"'  `"Agency FE"' `"Year FE"' )) "

. 
. ***********************************
. **# Heterogeneity Anlaysis: Crime
. ***********************************
. estimates clear

. eststo clear

. foreach T in up25 up50 up100 {
  2.         foreach v in actual_burg_total actual_mtr_theft actual_theft_total
>  actual_robbery_total violent_other assault_simple property_fe_juv property_m
> _juv property_fe_adult property_m_adult {
  3.                 di "`v' `T'"
  4.                 ppmlhdfe `v'  `T'  $x if (t_sample_0==1 | t_sample_`T' == 
> 1), absorb(orin year) vce(cluster countyfips) d exp(agency_population)
  5.                 su `v' if e(sample) == 1 & t_sample_`T' == 1 & (year<tgrou
> p_`T')
  6.                 estadd scalar y_mean = r(mean)
  7.                 estadd scalar pct = 100*(exp(_b[`T']) - 1)
  8.                 margins, at(`T'=(0 1)) subpop(if t_sample_`T' == 1 & year<
> tgroup_`T') contrast(atcontrast(r) nowald)
  9.                 estadd scalar ame = r(b)[1,1]
 10.                 estadd scalar ame_se  = sqrt(r(V)[1,1])
 11.                 estadd local countyDemo = "Y", replace
 12.                 estadd local agencyFE = "Y", replace
 13.                 estadd local yearFE   = "Y", replace
 14.                 eststo `v'_`T'
 15.         }
 16.         esttab *_`T' using "./result/table/figure3_estimates_`T'.csv", b(3
> ) se(3) csv star(* 0.10 ** 0.05 *** 0.01) keep(`T') $tab_opt replace
 17. }
