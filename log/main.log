. ******************************
. **# Panel B: personal income IQR, ACS
. ******************************
. use "./data_clean/sample_acs.dta", clear

. 
. * covariates
. global x white black nonhispan female_fertage age_le9 age_10_19 age_20_29 age
> _30_39 age_40_49 age_50_59

. 
. global option1  "stats(N y_mean demo countyFE yearFE , fmt(0 3) labels(`"N"' 
> `"E[Y|Pre, Treat]"' `"Demographic Controls"' `"County FE"' `"Year FE"' )) "

. 
. estimates clear

. eststo clear

. foreach T in up25 up50 up100 {
  2.         foreach v in incearn_2010 {
  3.                 di "`v' `T'"
  4.                 rifhdreg `v' `T' if (t_sample_0==1 | t_sample_`T' == 1) [p
> weight=perwt], rif(iqr(25 75)) abs(countyfips year)  iseed(123) over(`T') rwl
> ogit() att vce(cluster countyfips)
  5.                 // baseline: IQR of the treated group before treatment, we
> ighted as the regression
.                 _pctile `v' [pw=perwt] if e(sample) == 1 & t_sample_`T' == 1 
> & `T' == 0, p(25 75)
  6.                 estadd scalar y_mean = r(r2) - r(r1)
  7.                 estadd local countyFE = "Y", replace
  8.                 estadd local yearFE   = "Y", replace
  9.                 eststo `v'_`T'_0
 10. 
.                 rifhdreg `v' `T' $x if (t_sample_0==1 | t_sample_`T' == 1) [p
> weight=perwt], rif(iqr(25 75)) abs(countyfips year)  iseed(123) over(`T') rwl
> ogit($x ) att vce(cluster countyfips)
 11.                 _pctile `v' [pw=perwt] if e(sample) == 1 & t_sample_`T' ==
>  1 & `T' == 0, p(25 75)
 12.                 estadd scalar y_mean = r(r2) - r(r1)
 13.                 estadd local demo = "Y", replace
 14.                 estadd local countyFE = "Y", replace
 15.                 estadd local yearFE   = "Y", replace
 16.                 eststo `v'_`T'_1
 17.         }
 18. }
