. *-------------------------------------------------------
. * project: Abortion and Crime
. *-------------------------------------------------------
. 
. local pgm  "figure5" // file name

. local who  "Ben Xue"            // author

. local dte  "2026-10-26"            // created date

. local dte2 "`c(current_date)'"     // last run date

. local tag  "`pgm'.do, created by `who' on `dte', last run on `dte2'"

. display "`tag'"
figure5.do, created by Ben Xue on 2026-10-26, last run on 26 Oct 2026

. 
. /*
> Figure 5. Dynamic Impact of Abortion Provider Distance on Non-Property Crime
>  Panel A: Poisson event study (crime counts)
>  Panel B: Borusyak, Jaravel and Spiess (2024) imputation estimator (crime rat
> es)
>  Panel C: Sun and Abraham (2021) estimator (crime rates)
> All with county demographics, on the Table 1 estimation sample (columns 2, 4,
>  6).
> Output: ./result/figure/figure5_panelA_poisson.png
>         ./result/figure/figure5_panelB_bjs.png
>         ./result/figure/figure5_panelC_sa.png
> */
. 
. use "./data_clean/sample_agency.dta", clear

. xtset orin year

Panel variable: orin (strongly balanced)
 Time variable: year, 2009 to 2019
         Delta: 1 unit

. 
. * covariates
. global x white_shr black_shr nonhispan_shr age_15_44_f_shr age_le9_shr age_10
> _19_shr age_20_29_shr age_30_39_shr age_40_49_shr age_50_59_shr

. 
. * estimation sample of Table 1
. foreach T in up25 up50 up100 {
  2.         foreach v in nonproperty {
  3.                 qui ppmlhdfe `v'  `T'  $x if (t_sample_0==1 | t_sample_`T'
>  == 1) , absorb(orin year ) vce(cluster countyfips) d exp(agency_population)
  4.                 gen sample_`T'_`v' = e(sample)
  5.                 tab sample_`T'_`v'
  6.         }
  7. }

