. *********************
. **# Sun and Abraham
. *********************
. estimates clear

. eststo clear

. foreach T in up25 up50 up100 {
  2.         capture drop tgroup_`T'_m
  3.         gen tgroup_`T'_m = tgroup_`T'
  4.         replace tgroup_`T'_m = . if tgroup_`T' == 0
  5. 
.         capture drop rel_`T' g_`T'
  6.         capture drop em4 em3 em2 em1 e0 e1 e2 e3 e4 e5
  7. 
.     * First treatment year
.     bysort orin (year): egen g_`T' = min(cond(`T'==1, year, .))
  8. 
.         * relative/event time
.         gen rel_`T' = year - g_`T'
  9. 
.     * Leads
.     gen em4 = rel_`T' == -4
 10.     gen em3 = rel_`T' == -3
 11.     gen em2 = rel_`T' == -2
 12. 
.     * -1 omitted
.         gen em1=0
 13. 
.     * Treatment/post
.     gen e0 = rel_`T' == 0
 14.     gen e1 = rel_`T' == 1
 15.     gen e2 = rel_`T' == 2
 16.     gen e3 = rel_`T' == 3
 17.     gen e4 = rel_`T' == 4
 18.     gen e5 = rel_`T' >= 5
 19. 
.         foreach v in nonproperty {
 20.                 eventstudyinteract `v'_r em4 em3 em2 em1 e0 e1 e2 e3 e4 e5
>  [pw=agency_population] if sample_`T'_`v' == 1 , cohort(tgroup_`T'_m) control
> _cohort(t_sample_0) absorb(orin  year) vce(cluster countyfips) covariates($x 
> )
 21. 
.         matrix C = e(b_iw)
 22.         mata st_matrix("A",sqrt(diagonal(st_matrix("e(V_iw)"))))
 23.         matrix C_`T'_`v' = C \ A'
 24.         }
 25. }
