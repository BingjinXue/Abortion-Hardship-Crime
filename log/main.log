. do "./code/analysis/table1.do"

. clear all

. 
. *-------------------------------------------------------
. * project: Abortion and Crime
. *-------------------------------------------------------
. 
. local pgm  "table1" // file name

. local who  "Ben Xue"            // author

. local dte  "2026-10-26"            // created date

. local dte2 "`c(current_date)'"     // last run date

. local tag  "`pgm'.do, created by `who' on `dte', last run on `dte2'"

. display "`tag'"
table1.do, created by Ben Xue on 2026-10-26, last run on 26 Oct 2026

. 
. /*
> Table 1. Impact of Abortion Provider Distance on Crime, Baseline
> Poisson DiD, agency and year FE, exposure agency population, SE clustered by 
> county.
> For each treatment threshold (25, 50, 100 miles): without covariates, then wi
> th county demographics.
> Output: ./result/table/table1_panelA_property.csv
>         ./result/table/table1_panelB_nonproperty.csv
> */
. 
. use "./data_clean/sample_agency.dta", clear

. xtset orin year

Panel variable: orin (strongly balanced)
 Time variable: year, 2009 to 2019
         Delta: 1 unit

. 
. * covariates
. global x white_shr black_shr nonhispan_shr age_15_44_f_shr age_le9_shr age_10
> _19_shr age_20_29_shr age_30_39_shr age_40_49_shr age_50_59_shr

. 
. global tab_opt  "stats(pct ame ame_se N y_mean countyDemo agencyFE yearFE , f
> mt(1 3 3 0 3) labels(`"% effect"' `"AME"' `"AME S.E."' `"N"' `"E[Y|Pre, Treat
> ]"' `"County Demographics"'  `"Agency FE"' `"Year FE"' )) "

. 
. *********************
. **# Poisson DiD
. *********************
. estimates clear

. eststo clear

. foreach v in index_property nonproperty {
  2.         foreach T in up25 up50 up100 {
  3.                 di "`v' `T'"
  4.                 // with county demographics
.                 ppmlhdfe `v'  `T'  $x if (t_sample_0==1 | t_sample_`T' == 1) 
> , absorb(orin year ) vce(cluster countyfips) d exp(agency_population)
  5.                 gen sample_`T'_`v' = e(sample)
  6.                 su `v' if e(sample) == 1 & t_sample_`T' == 1 & (year<tgrou
> p_`T') // treat pre
  7.                 estadd scalar y_mean = r(mean)
  8.                 estadd scalar pct = 100*(exp(_b[`T']) - 1)
  9.                 // AME: 0/1 change at the treated pre-period observations
.                 margins, at(`T'=(0 1)) subpop(if t_sample_`T' == 1 & year<tgr
> oup_`T') contrast(atcontrast(r) nowald)
 10.                 estadd scalar ame = r(b)[1,1]
 11.                 estadd scalar ame_se  = sqrt(r(V)[1,1])
 12.                 estadd local countyDemo = "Y", replace
 13.                 estadd local agencyFE = "Y", replace
 14.                 estadd local yearFE   = "Y", replace
 15.                 eststo `v'_`T'_1
 16. 
.                 // without covariates, same sample
.                 ppmlhdfe `v'  `T' if sample_`T'_`v'==1 , absorb(orin year ) v
> ce(cluster countyfips) d exp(agency_population)
 17.                 su `v' if e(sample) == 1 & t_sample_`T' == 1 & (year<tgrou
> p_`T') // treat pre
 18.                 estadd scalar y_mean = r(mean)
 19.                 estadd scalar pct = 100*(exp(_b[`T']) - 1)
 20.                 margins, at(`T'=(0 1)) subpop(if t_sample_`T' == 1 & year<
> tgroup_`T') contrast(atcontrast(r) nowald)
 21.                 estadd scalar ame = r(b)[1,1]
 22.                 estadd scalar ame_se  = sqrt(r(V)[1,1])
 23.                 estadd local agencyFE = "Y", replace
 24.                 estadd local yearFE   = "Y", replace
 25.                 eststo `v'_`T'_0
 26.         }
 27. }
