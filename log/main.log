. do "./code/analysis/table2.do"

. clear all

. 
. *-------------------------------------------------------
. * project: Abortion and Crime
. *-------------------------------------------------------
. 
. local pgm  "table2" // file name

. local who  "Ben Xue"            // author

. local dte  "2026-10-26"            // created date

. local dte2 "`c(current_date)'"     // last run date

. local tag  "`pgm'.do, created by `who' on `dte', last run on `dte2'"

. display "`tag'"
table2.do, created by Ben Xue on 2026-10-26, last run on 26 Oct 2026

. 
. /*
> Table 2. Impact of Abortion Provider Distance on Labor Market Outcomes
> County x year panel of the counties in the agency sample; county and year FE.
>  Panel A: number of individuals in the labor force, Poisson (exposure county 
> population)
>  Panel B: unemployment rate, linear (weighted by county population)
> For each treatment threshold (25, 50, 100 miles): without covariates, then wi
> th county demographics.
> Output: ./result/table/table2_panelA_labor_force.csv
>         ./result/table/table2_panelB_unemployment.csv
> */
. 
. use "./data_clean/sample_agency.dta", clear

. 
. * covariates
. global x white_shr black_shr nonhispan_shr age_15_44_f_shr age_le9_shr age_10
> _19_shr age_20_29_shr age_30_39_shr age_40_49_shr age_50_59_shr

. 
. global optionmech       "stats(ame ame_se N y_mean countyDemo countyFE yearFE
>  , fmt(3 3 0 3 0 ) labels(`"AME"' `"AME S.E."' `"N"' `"E[Y|Pre, Treat]"' `"Co
> unty Demographics"'  `"County FE"' `"Year FE"' )) "

. 
. // collapse to county level analysis, so that sample for mechanism and main r
> esults are consistent
. collapse num_labor_force unemprate t_sample_* tgroup* up* county_pop $x , by(
> countyfips year)

. xtset countyfips year

Panel variable: countyfips (strongly balanced)
 Time variable: year, 2009 to 2019
         Delta: 1 unit

. 
. estimates clear

. eststo clear

. foreach T in up25 up50 up100 {
  2.         // Poisson model
.         foreach v in num_labor_force {
  3.                 di "`v' `T'"
  4.                 ppmlhdfe `v'  `T' if (t_sample_0==1 | t_sample_`T' == 1), 
> absorb(countyfips year) vce(robust) d exp(county_pop)
  5.                 su `v' if e(sample) == 1 & t_sample_`T' == 1 & (year<tgrou
> p_`T')
  6.                 estadd scalar y_mean = r(mean)
  7.                 // AME: 0/1 change at the treated pre-period observations
.                 margins, at(`T'=(0 1)) subpop(if t_sample_`T' == 1 & year<tgr
> oup_`T') contrast(atcontrast(r) nowald)
  8.                 estadd scalar ame = r(b)[1,1]
  9.                 estadd scalar ame_se  = sqrt(r(V)[1,1])
 10.                 estadd local countyFE = "Y", replace
 11.                 estadd local yearFE   = "Y", replace
 12.                 eststo `v'_`T'_0
 13. 
.                 ppmlhdfe `v'  `T' $x if (t_sample_0==1 | t_sample_`T' == 1), 
> absorb(countyfips year) vce(robust) d exp(county_pop)
 14.                 su `v' if e(sample) == 1 & t_sample_`T' == 1 & (year<tgrou
> p_`T')
 15.                 estadd scalar y_mean = r(mean)
 16.                 margins, at(`T'=(0 1)) subpop(if t_sample_`T' == 1 & year<
> tgroup_`T') contrast(atcontrast(r) nowald)
 17.                 estadd scalar ame = r(b)[1,1]
 18.                 estadd scalar ame_se  = sqrt(r(V)[1,1])
 19.                 estadd local countyDemo = "Y", replace
 20.                 estadd local countyFE = "Y", replace
 21.                 estadd local yearFE   = "Y", replace
 22.                 eststo `v'_`T'_1
 23.         }
 24. 
.         // Linear model
.         foreach v in unemprate {
 25.                 di "`v' `T'"
 26.                 reghdfe `v'  `T'  [aw=county_pop] if (t_sample_0==1 | t_sa
> mple_`T' == 1) , absorb(countyfips year) vce(robust)
 27.                 su `v' [aw=county_pop] if e(sample) == 1 & t_sample_`T' ==
>  1 & (year<tgroup_`T')
 28.                 estadd scalar y_mean = r(mean)
 29.                 estadd local countyFE = "Y", replace
 30.                 estadd local yearFE   = "Y", replace
 31.                 eststo `v'_`T'_0
 32. 
.                 reghdfe `v'  `T' $x  [aw=county_pop] if (t_sample_0==1 | t_sa
> mple_`T' == 1) , absorb(countyfips year) vce(robust)
 33.                 su `v' [aw=county_pop] if e(sample) == 1 & t_sample_`T' ==
>  1 & (year<tgroup_`T')
 34.                 estadd scalar y_mean = r(mean)
 35.                 estadd local countyDemo = "Y", replace
 36.                 estadd local countyFE = "Y", replace
 37.                 estadd local yearFE   = "Y", replace
 38.                 eststo `v'_`T'_1
 39.         }
 40. }
