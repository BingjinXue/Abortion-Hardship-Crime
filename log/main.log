. do "./code/analysis/table3.do"

. clear all

. 
. *-------------------------------------------------------
. * project: Abortion and Crime
. *-------------------------------------------------------
. 
. local pgm  "table3" // file name

. local who  "Ben Xue"            // author

. local dte  "2026-10-26"            // created date

. local dte2 "`c(current_date)'"     // last run date

. local tag  "`pgm'.do, created by `who' on `dte', last run on `dte2'"

. display "`tag'"
table3.do, created by Ben Xue on 2026-10-26, last run on 26 Oct 2026

. 
. /*
> Table 3. Impact of Abortion Provider Distance on Financial Outcomes
>  Panels A, C, D, E: county x year panel of the counties in the agency sample;
>  county and year FE
>    A: personal income per capita (BEA), linear (weighted by county population
> )
>    C: debt-to-income ratio, linear (weighted by county population)
>    D: mortgage delinquency rate (>= 90 days), linear (weighted by county popu
> lation)
>    E: number of evictions, Poisson (exposure county population)
>  Panel B: interquartile range of personal earned income (ACS persons aged 15-
> 44), RIF regression (Rios-Avila 2020)
> For each treatment threshold (25, 50, 100 miles): without covariates, then wi
> th demographics.
> Output: ./result/table/table3_panelA_income.csv
>         ./result/table/table3_panelB_income_iqr.csv
>         ./result/table/table3_panelC_debt_to_income.csv
>         ./result/table/table3_panelD_mortgage_delinquency.csv
>         ./result/table/table3_panelE_evictions.csv
> */
. 
. global optionmech       "stats(ame ame_se N y_mean countyDemo countyFE yearFE
>  , fmt(3 3 0 3 0 ) labels(`"AME"' `"AME S.E."' `"N"' `"E[Y|Pre, Treat]"' `"De
> mographic Controls"'  `"County FE"' `"Year FE"' )) "

. 
. ******************************
. **# Panels A, C, D, E: county level
. ******************************
. use "./data_clean/sample_agency.dta", clear

. 
. * covariates
. global x white_shr black_shr nonhispan_shr age_15_44_f_shr age_le9_shr age_10
> _19_shr age_20_29_shr age_30_39_shr age_40_49_shr age_50_59_shr

. 
. // collapse to county level analysis, so that sample for mechanism and main r
> esults are consistent
. collapse pc_inc debt_to_inc_ub delinquent_90plus filings_observed t_sample_* 
> tgroup* up* county_pop $x , by(countyfips year)

. xtset countyfips year

Panel variable: countyfips (strongly balanced)
 Time variable: year, 2009 to 2019
         Delta: 1 unit

. 
. estimates clear

. eststo clear

. foreach T in up25 up50 up100 {
  2.         // Linear model
.         foreach v in pc_inc debt_to_inc_ub delinquent_90plus {
  3.                 di "`v' `T'"
  4.                 reghdfe `v'  `T'  [aw=county_pop] if (t_sample_0==1 | t_sa
> mple_`T' == 1) , absorb(countyfips year) vce(robust)
  5.                 su `v' [aw=county_pop] if e(sample) == 1 & t_sample_`T' ==
>  1 & (year<tgroup_`T')
  6.                 estadd scalar y_mean = r(mean)
  7.                 estadd local countyFE = "Y", replace
  8.                 estadd local yearFE   = "Y", replace
  9.                 eststo `v'_`T'_0
 10. 
.                 reghdfe `v'  `T' $x  [aw=county_pop] if (t_sample_0==1 | t_sa
> mple_`T' == 1) , absorb(countyfips year) vce(robust)
 11.                 su `v' [aw=county_pop] if e(sample) == 1 & t_sample_`T' ==
>  1 & (year<tgroup_`T')
 12.                 estadd scalar y_mean = r(mean)
 13.                 estadd local countyDemo = "Y", replace
 14.                 estadd local countyFE = "Y", replace
 15.                 estadd local yearFE   = "Y", replace
 16.                 eststo `v'_`T'_1
 17.         }
 18. 
.         // Poisson model
.         foreach v in filings_observed {
 19.                 di "`v' `T'"
 20.                 ppmlhdfe `v'  `T' if (t_sample_0==1 | t_sample_`T' == 1), 
> absorb(countyfips year) vce(robust) d exp(county_pop)
 21.                 su `v' if e(sample) == 1 & t_sample_`T' == 1 & (year<tgrou
> p_`T')
 22.                 estadd scalar y_mean = r(mean)
 23.                 // AME: 0/1 change at the treated pre-period observations
.                 margins, at(`T'=(0 1)) subpop(if t_sample_`T' == 1 & year<tgr
> oup_`T') contrast(atcontrast(r) nowald)
 24.                 estadd scalar ame = r(b)[1,1]
 25.                 estadd scalar ame_se  = sqrt(r(V)[1,1])
 26.                 estadd local countyFE = "Y", replace
 27.                 estadd local yearFE   = "Y", replace
 28.                 eststo `v'_`T'_0
 29. 
.                 ppmlhdfe `v'  `T' $x if (t_sample_0==1 | t_sample_`T' == 1), 
> absorb(countyfips year) vce(robust) d exp(county_pop)
 30.                 su `v' if e(sample) == 1 & t_sample_`T' == 1 & (year<tgrou
> p_`T')
 31.                 estadd scalar y_mean = r(mean)
 32.                 margins, at(`T'=(0 1)) subpop(if t_sample_`T' == 1 & year<
> tgroup_`T') contrast(atcontrast(r) nowald)
 33.                 estadd scalar ame = r(b)[1,1]
 34.                 estadd scalar ame_se  = sqrt(r(V)[1,1])
 35.                 estadd local countyDemo = "Y", replace
 36.                 estadd local countyFE = "Y", replace
 37.                 estadd local yearFE   = "Y", replace
 38.                 eststo `v'_`T'_1
 39.         }
 40. }
